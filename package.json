{
  "name": "reflection-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reflection: verified local tarot MVP; deployment disabled",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "provider:evaluate": "tsx scripts/provider-evaluate.ts",
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --local",
    "schemas": "tsx scripts/schemas.ts",
    "check:schemas": "tsx scripts/schemas.ts --check",
    "typecheck": "tsc --noEmit",
    "check:contracts": "tsx checks/check-contracts.ts",
    "check:sql": "python3 checks/check-sql.py",
    "check:registry": "python3 scripts/check-registry.py",
    "check:openapi": "tsx checks/check-openapi.ts",
    "test": "npm run test:domain && npm run test:db",
    "test:domain": "vitest run --config vitest.domain.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "build": "vite build && wrangler deploy --dry-run --env-file scripts/verification.env --outdir dist/worker",
    "verify": "tsx scripts/verify.ts",
    "release": "tsx scripts/release.ts",
    "dev:identity": "tsx scripts/local-identity.ts",
    "dev:live": "tsx scripts/local-live.ts",
    "test:browser": "playwright test",
    "restore:rehearse": "vitest run --config vitest.db.config.ts tests/db/privacy-restore.test.ts tests/db/privacy-review-regressions.test.ts",
    "cleanup:rehearse": "vitest run --config vitest.db.config.ts tests/db/storage-accounting.test.ts tests/db/retention.test.ts tests/db/recovery-cleanup.test.ts tests/db/cleanup-review-regressions.test.ts",
    "package": "tsx scripts/package.ts",
    "key:rotate": "tsx scripts/key-rotation.ts",
    "check:publication-guard": "tsx scripts/generate-publication-guard.ts --check",
    "content:activate": "tsx scripts/content-activate.ts",
    "provider:reconcile": "tsx scripts/provider-reconcile.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@biomejs/biome": "2.6.3",
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261026.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "miniflare": "5.20261023.0-beta",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0",
    "yaml": "2.9.1"
  }
}
