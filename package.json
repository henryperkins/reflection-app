{
  "name": "reflection-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reflection Milestone 1: local synthetic foundation",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --local",
    "schemas": "tsx scripts/schemas.ts",
    "check:schemas": "tsx scripts/schemas.ts --check",
    "typecheck": "tsc --noEmit",
    "check:contracts": "tsx checks/check-contracts.ts",
    "check:sql": "python3 checks/check-sql.py",
    "check:registry": "python3 scripts/check-registry.py",
    "check:openapi": "tsx checks/check-openapi.ts",
    "test": "vitest run",
    "test:domain": "vitest run --config vitest.domain.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "verify": "tsx scripts/verify.ts",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@apidevtools/swagger-parser": "12.1.0",
    "@biomejs/biome": "2.6.3",
    "typescript": "5.9.3",
    "tsx": "4.21.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0",
    "yaml": "2.9.1"
  }
}
