{
  "name": "reflection-architecture-checks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Disposable specification-artifact checks; not an application",
  "scripts": {
    "schemas": "tsx checks/generate-openapi.ts",
    "check:contracts": "tsc --noEmit && tsx checks/check-contracts.ts",
    "check:sql": "python3 checks/check-sql.py",
    "check:openapi": "tsx checks/check-openapi.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/node": "22.19.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "yaml": "2.8.2",
    "zod": "4.6.7"
  }
}
